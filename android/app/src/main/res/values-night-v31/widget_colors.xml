    <color name="widget_text_dim">@android:color/system_accent1_200</color>
    <color name="widget_divider">@android:color/system_accent1_600</color>
    <color name="widget_accent">@android:color/system_accent1_200</color>
    <color name="widget_icon">@android:color/system_accent1_50</color>
    <color name="widget_icon_dim">@android:color/system_accent1_300</color>
    <color name="widget_button_bg">@android:color/system_accent1_700</color>
