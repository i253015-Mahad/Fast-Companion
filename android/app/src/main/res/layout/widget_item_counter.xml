<?xml version="1.0" encoding="utf-8"?>
<!-- One counter row inside the scrolling list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/counter_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/counter_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/widget_text"
        android:textSize="17sp"
        android:maxLines="2" />

    <ImageButton
        android:id="@+id/counter_minus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_round_button"
        android:src="@drawable/ic_minus"
        android:contentDescription="Decrease" />

    <TextView
        android:id="@+id/counter_count"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/counter_plus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_round_button"
        android:src="@drawable/ic_plus"
        android:contentDescription="Increase" />
</LinearLayout>
